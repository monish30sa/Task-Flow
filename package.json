{
  "name": "react-task-manager",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:api\" \"npm:client\"",
    "client": "vite",
    "api": "json-server --watch db.json --port 3001",
